@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewBag.Title = "Explore";
}
@model IEnumerable<Stock>

<div class="explore-container">

    <!-- Left Column: Stocks List -->
    <div class="stocks-panel">
        <div class="stocks-header">
            <h3>Stocks</h3>
            <a asp-action="Explore" asp-route-stockSymbol="">Show all stocks</a>
        </div>

        <div class="stocks-list">
            @foreach (Stock stock in Model)
            {
                <a href="#"
                   class="stock-item"
                   onclick="loadStockDetails(event, '@stock.StockSymbol')">

                    <div class="stock-name">
                        @stock.StockName
                    </div>

                    <div class="stock-symbol">
                        (@stock.StockSymbol)
                    </div>

                </a>
            }
        </div>
    </div>

    <!-- Right Column: View Component -->
    <div class="selected-stock-container" id="stock-details-panel">
        @if (ViewBag.StockSymbol != null)
        {
            @await Component.InvokeAsync("SelectedStock", new { stockSymbol = ViewBag.StockSymbol })
        }
        else
        {
            <div style="text-align: center; color: #8a8a8a; margin-top: 50px;">
                <h3>Select a stock to view details</h3>
            </div>
        }
    </div>
</div>

@section scripts {
    <script src="~/JS/finnhubwebsocket.js" asp-append-version="true"></script>

    <script>
        // Store the token from appsettings.json
        const secretToken = '@Configuration["TradingApiOptions:ApiKey"]';

        async function loadStockDetails(event, symbol) {
            event.preventDefault();

            const panel = document.getElementById('stock-details-panel');

            // Show a loading state
            panel.innerHTML = '<div style="margin-top: 50px; text-align: center; color: #666;">Loading...</div>';

            try {
                const response = await fetch(`/Stock/GetStockDetails/${symbol}`);

                if (!response.ok) {
                    throw new Error("Network response was not ok");
                }

                // Extract and inject HTML
                const html = await response.text();
                panel.innerHTML = html;

                // IMPORTANT: Initialize the WebSocket for the new stock after HTML is injected
                initStockSocket(secretToken);

            } catch (error) {
                console.error("Failed to fetch stock details:", error);
                panel.innerHTML = '<div style="color: red; margin-top: 20px;">Failed to load stock details. Please try again.</div>';
            }
        }

        // Handle initial page load if a stock was pre-selected via ViewBag
        document.addEventListener("DOMContentLoaded", function() {
            const initialSymbol = document.getElementById("StockSymbol");
            if (initialSymbol) {
                initStockSocket(secretToken);
            }
        });

        // Clean up socket when user switches tabs to save bandwidth, reconnect when they return
        document.addEventListener("visibilitychange", function() {
            if (document.visibilityState === "hidden") {
                cleanupSocket();
            } else if (document.visibilityState === "visible") {
                const currentSymbolInput = document.getElementById("StockSymbol");
                if (currentSymbolInput) {
                    initStockSocket(secretToken);
                }
            }
        });
    </script>
}